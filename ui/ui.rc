#pragma code_page(65001)  // .rc 为 UTF-8，显式声明避免 rc.exe 按 GBK 解析吞引号
#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "app.ico"

IDD_SETTINGS DIALOGEX 0, 0, 260, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "屏幕录制设置"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "显示器:", -1, 12, 16, 50, 10
    COMBOBOX        IDC_MONITOR, 70, 14, 170, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "帧率:", -1, 12, 40, 50, 10
    COMBOBOX        IDC_FPS, 70, 38, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "格式:", -1, 12, 66, 50, 10
    COMBOBOX        IDC_FORMAT, 70, 64, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "质量:", -1, 12, 86, 50, 10
    COMBOBOX        IDC_QUALITY, 70, 84, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "编码器:", -1, 12, 110, 50, 10
    COMBOBOX        IDC_ENCODER, 70, 108, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CHECKBOX        "录制系统声音", IDC_SYSAUD, 12, 130, 90, 10
    EDITTEXT        IDC_SYSAUD_VOL, 110, 128, 40, 13, ES_AUTOHSCROLL
    LTEXT           "音量%", -1, 154, 130, 40, 10
    CHECKBOX        "录制麦克风", IDC_MIC, 12, 148, 90, 10
    EDITTEXT        IDC_MIC_VOL, 110, 146, 40, 13, ES_AUTOHSCROLL
    LTEXT           "音量%", -1, 154, 148, 40, 10
    CHECKBOX        "包含鼠标光标", IDC_CURSOR, 12, 166, 120, 10
    LTEXT           "输出目录:", -1, 12, 186, 50, 10
    EDITTEXT        IDC_OUTDIR, 70, 184, 130, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览...", IDC_BROWSE, 204, 184, 44, 14
    DEFPUSHBUTTON   "确定", IDOK, 150, 216, 44, 14
    PUSHBUTTON      "取消", IDCANCEL, 200, 216, 44, 14
END
